{
  "name": "DevOps Manager",
  "url": "https://devops.example.com",
  "description": "GitHub Actions insights and management (self-hosted DevOps Manager instance).",
  "public": true,
  "hook_attributes": {
    "url": "https://devops.example.com/api/github/webhook",
    "active": true
  },
  "redirect_url": "https://devops.example.com/onboarding",
  "callback_urls": [
    "https://devops.example.com/api/auth/callback/github",
    "https://devops.example.com/api/github/connect/callback"
  ],
  "setup_url": "https://devops.example.com/onboarding",
  "setup_on_update": true,
  "request_oauth_on_install": false,
  "default_events": ["workflow_run", "workflow_job", "repository"],
  "default_permissions": {
    "metadata": "read",
    "actions": "write",
    "contents": "write",
    "pull_requests": "write",
    "workflows": "write",
    "checks": "read",
    "statuses": "read",
    "actions_variables": "write",
    "vulnerability_alerts": "read",
    "administration": "read",
    "organization_self_hosted_runners": "read",
    "organization_actions_variables": "write",
    "organization_administration": "read",
    "emails": "read"
  }
}
