# DevOps Manager configuration. Copy to .env and fill in.
# Placeholders only: every host is example.com, every account example-*.
# Each secret also accepts <NAME>_FILE pointing to a file (Docker secrets).

# ---------- Core ----------
# Pooled URL (Neon "-pooler") or plain Postgres.
DATABASE_URL=postgresql://devops:change-me@localhost:5432/devops
# Direct (non-pooled) URL for migrations; defaults to DATABASE_URL.
DIRECT_URL=
# Docker Compose only: password of the bundled Postgres.
POSTGRES_PASSWORD=change-me

# Public base URL of this instance (callbacks, origin checks).
BETTER_AUTH_URL=https://devops.example.com
NEXT_PUBLIC_APP_URL=https://devops.example.com
# openssl rand -base64 48
BETTER_AUTH_SECRET=
# 32 bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Set during key rotation only (decrypt-only).
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# openssl rand -hex 32 (sent by Vercel cron and the Docker cron sidecar)
CRON_SECRET=
# openssl rand -hex 32 (IPs are stored only as HMAC(AUDIT_IP_SALT, ip))
AUDIT_IP_SALT=
# Comma-separated headers holding the client IP. List only headers your
# reverse proxy sets and overwrites (e.g. x-real-ip, cf-connecting-ip); any
# client can send them when port 3000 is reachable without the proxy.
TRUSTED_IP_HEADERS=x-forwarded-for
LOG_LEVEL=info
# en (default) or de
DEFAULT_LOCALE=en

# ---------- Login: OIDC (primary) ----------
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=devops-manager
OIDC_CLIENT_SECRET=
# Redirect URI to register at the provider:
#   https://devops.example.com/api/auth/callback/oidc
OIDC_PROVIDER_NAME=Single sign-on
OIDC_SCOPES=openid email profile groups
OIDC_GROUPS_CLAIM=groups
# Comma-separated; when set, sign-in requires one of these groups.
OIDC_ALLOWED_GROUPS=
OIDC_REQUIRE_VERIFIED_EMAIL=true
SESSION_MAX_AGE_HOURS=12

# ---------- Login: GitHub (optional) ----------
GITHUB_LOGIN_ENABLED=false

# ---------- Roles (at least one admin rule) ----------
ADMIN_EMAILS=admin@example.com
ADMIN_GROUPS=
OPERATOR_EMAILS=
OPERATOR_GROUPS=devops-operators
VIEWER_EMAILS=
VIEWER_GROUPS=devops-viewers
# none (refuse) or viewer, for users who pass the gate but match no rule.
DEFAULT_ROLE=none

# ---------- GitHub App ----------
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=example-devops-manager
# PEM (with \n escapes) or base64 of the PEM; or GITHUB_APP_PRIVATE_KEY_FILE.
GITHUB_APP_PRIVATE_KEY=
# Only for GitHub login or "Connect GitHub" (M2).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 32 random bytes: openssl rand -hex 32. Optional in polling-only mode.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET_PREVIOUS=
# GitHub accounts (personal account and organisations) whose installations are accepted.
ALLOWED_ACCOUNTS=example-user,example-org

# ---------- Personal billing (optional, M2) ----------
GITHUB_BILLING_TOKEN=
GITHUB_CONNECT_ENABLED=false

# ---------- Hosting: Vercel (optional, M5) ----------
# Admins usually connect a team-scoped token in the settings instead. The env
# token belongs to the installation of VERCEL_ACCOUNT and is never stored.
VERCEL_TOKEN=
# Only for a full-account token that reaches several teams (team_...).
VERCEL_TEAM_ID=
VERCEL_ACCOUNT=
# Team ids or slugs that may be connected; empty = any.
ALLOWED_VERCEL_TEAMS=

# ---------- Management ----------
MANAGEMENT_ENABLED=true
# JSON list of {name, values[], scope}; default: LINUX_RUNNER / MACOS_RUNNER.
VARIABLE_PRESETS=
MERGE_AUDIT_TRAILER=false

# ---------- Sync and retention ----------
BACKFILL_DAYS=30
DEFAULT_RETENTION_DAYS=90
MAX_RETENTION_DAYS=90
# true when the App's workflow_run subscription is turned off (runs come from reconcile).
LEAN_WEBHOOKS=false
LAZY_RECONCILE_MINUTES=15
CRON_INTERVAL_SECONDS=600
