// DevOps Manager database schema (milestone M0).
//
// Conventions:
// - GitHub ids are BigInt and are serialised as strings in DTOs.
// - Timestamps are timestamptz(3).
// - Every tenant table has an installationId column, and every tenant index
//   leads with it. Tenant data is only read through src/server/data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- better-auth (users, sessions, accounts) ----------

enum AppRole {
  VIEWER
  OPERATOR
  ADMIN
}

model User {
  id             String    @id
  name           String
  /// From the OIDC provider or GitHub (verified primary email).
  email          String    @unique
  emailVerified  Boolean   @default(false)
  /// Not rendered (CSP); initials are shown instead.
  image          String?
  /// null = DEFAULT_LOCALE
  locale         String?
  /// Snapshot of the OIDC groups claim at the last OIDC sign-in.
  oidcGroups     String[]  @default([])
  /// Resolved from the env allowlists at the last sign-in.
  envRole        AppRole?
  /// Set by an admin (M4). Effective role = max(envRole, roleOverride).
  roleOverride   AppRole?
  roleOverrideBy String?
  roleOverrideAt DateTime? @db.Timestamptz(3)
  /// Ignored for env-assigned roles (break-glass).
  disabledAt     DateTime? @db.Timestamptz(3)
  lastLoginAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// providerId is "oidc" or "github"; accountId is the provider's subject.
/// accessToken, refreshToken and idToken are dropped by the account hook
/// (src/server/better-auth/hooks.ts): they are not needed after sign-in.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ---------- tenancy ----------

enum AccountType {
  USER
  ORGANIZATION
}

enum RepoSelection {
  ALL
  SELECTED
}

model Installation {
  /// GitHub installation id
  id                   BigInt        @id
  accountId            BigInt
  accountLogin         String        @unique
  accountType          AccountType
  repositorySelection  RepoSelection
  /// Granted permissions, as reported by GitHub.
  permissions          Json
  events               String[]
  permissionsCheckedAt DateTime?     @db.Timestamptz(3)
  /// Per-installation management toggle (admin only), off by default.
  managementEnabled    Boolean       @default(false)
  timezone             String        @default("UTC")
  /// 14..400, capped by MAX_RETENTION_DAYS.
  rawRetentionDays     Int           @default(90)
  includedMinutes      Int?
  planName             String?
  suspendedAt          DateTime?     @db.Timestamptz(3)
  deletedAt            DateTime?     @db.Timestamptz(3)
  purgeAfter           DateTime?     @db.Timestamptz(3)
  lastWebhookAt        DateTime?     @db.Timestamptz(3)
  lastReconciledAt     DateTime?     @db.Timestamptz(3)
  /// Column lock (PgBouncer-safe, no advisory locks).
  reconcileLockedUntil DateTime?     @db.Timestamptz(3)
  /// Outcome of the last reconcile of this installation: ok | partial | skipped | error.
  lastReconcileStatus  String?
  /// Why the last reconcile was not ok (redacted), shown on the sync health page.
  lastReconcileReason  String?
  hookDeliveryCursor   String?
  /// Last daily prune of this installation's raw history (reconcile step i).
  lastPrunedAt         DateTime?     @db.Timestamptz(3)
  /// Last "Sync now" (operator), rate-limited to once per 5 minutes.
  syncRequestedAt      DateTime?     @db.Timestamptz(3)
  /// Last runner sample (reconcile step f or a lazy /runners view, at most every 2 min).
  runnersSampledAt     DateTime?     @db.Timestamptz(3)
  /// Last daily discovery pass over the repo-level runners of every active repo.
  runnersDiscoveredAt  DateTime?     @db.Timestamptz(3)
  /// Last billing sync (reconcile step h, once a day).
  billingSyncedAt      DateTime?     @db.Timestamptz(3)
  /// ok | no_permission | no_credential | unavailable | credential_error
  billingStatus        String?
  /// Truncated and redacted; never contains a token.
  billingError         String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  repositories Repository[]
}

// ---------- inventory ----------

model Repository {
  /// GitHub repository id
  id             BigInt       @id
  installationId BigInt
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  ownerLogin     String
  name           String
  fullName       String
  private        Boolean
  archived       Boolean      @default(false)
  defaultBranch  String       @default("main")
  /// Set when a SELF_HOSTED job is seen (M1).
  hasSelfHosted  Boolean      @default(false)
  removedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([installationId, fullName])
  @@index([installationId, removedAt])
}

model SyncState {
  repositoryId   BigInt    @id
  installationId BigInt
  /// Incremental sync high-water mark.
  runsCursor     DateTime? @db.Timestamptz(3)
  /// Oldest window covered so far.
  backfillUntil  DateTime? @db.Timestamptz(3)
  backfillDone   Boolean   @default(false)
  runsEtag       String?
  /// e.g. after an oversized (413) delivery
  needsResync    Boolean   @default(false)
  lastError      String?
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([installationId])
}

// ---------- Actions history (M1) ----------
//
// Runs and jobs are folded order-independently (src/server/ingest/fold.ts):
// any permutation or duplication of the same events yields the same row.
// Raw SQL in the migration adds partial indexes for open runs and queued jobs.

enum RunStatus {
  REQUESTED
  QUEUED
  WAITING
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum JobStatus {
  QUEUED
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum Conclusion {
  SUCCESS
  FAILURE
  CANCELLED
  SKIPPED
  TIMED_OUT
  ACTION_REQUIRED
  NEUTRAL
  STALE
  STARTUP_FAILURE
}

enum RunnerKind {
  GITHUB_HOSTED
  LARGER_HOSTED
  SELF_HOSTED
  UNKNOWN
}

enum RunnerOs {
  LINUX
  WINDOWS
  MACOS
  UNKNOWN
}

enum Source {
  WEBHOOK
  BACKFILL
  RECONCILE
}

model WorkflowRun {
  /// GitHub run id
  id                     BigInt      @id
  installationId         BigInt
  repositoryId           BigInt
  workflowId             BigInt?
  workflowName           String
  workflowPath           String?
  event                  String?
  headBranch             String?
  headSha                String
  isDefaultBranch        Boolean     @default(false)
  actorLogin             String?
  runNumber              Int?
  /// Latest attempt.
  runAttempt             Int         @default(1)
  /// Conclusion of attempt 1, for flakiness.
  firstAttemptConclusion Conclusion?
  status                 RunStatus
  /// requested/queued/pending = 1, waiting = 2, in_progress = 3, completed = 4; 0 = placeholder.
  statusRank             Int         @db.SmallInt
  conclusion             Conclusion?
  createdAt              DateTime    @db.Timestamptz(3)
  runStartedAt           DateTime?   @db.Timestamptz(3)
  completedAt            DateTime?   @db.Timestamptz(3)
  durationS              Int?
  /// Created from a job before its run arrived.
  isPlaceholder          Boolean     @default(false)
  htmlUrl                String?
  /// GitHub's updated_at; jobs are re-read when it is newer than jobsSyncedAt.
  githubUpdatedAt        DateTime?   @db.Timestamptz(3)
  jobsSyncedAt           DateTime?   @db.Timestamptz(3)
  source                 Source
  lastEventAt            DateTime    @db.Timestamptz(3)

  @@index([installationId, createdAt(sort: Desc)])
  @@index([repositoryId, createdAt(sort: Desc)])
  @@index([repositoryId, workflowId, createdAt])
}

model WorkflowJob {
  /// GitHub job id (one per attempt)
  id               BigInt      @id
  runId            BigInt
  runAttempt       Int
  installationId   BigInt
  repositoryId     BigInt
  workflowId       BigInt?
  workflowName     String
  name             String
  /// Matrix suffix " (..)" stripped.
  baseName         String
  /// First write, sorted, lowercase.
  labels           String[]
  /// Sorted labels joined by ",".
  labelKey         String
  status           JobStatus
  /// queued = 1, waiting = 2, in_progress = 3, completed = 4.
  statusRank       Int         @db.SmallInt
  conclusion       Conclusion?
  runnerId         BigInt?
  runnerName       String?
  runnerGroupId    BigInt?
  runnerGroupName  String?
  runnerKind       RunnerKind  @default(UNKNOWN)
  runnerOs         RunnerOs    @default(UNKNOWN)
  /// e.g. "linux", "windows", "macos", "linux_4_core"
  sku              String?
  createdAt        DateTime    @db.Timestamptz(3)
  /// Environment approval: first `waiting` event.
  waitingStartedAt DateTime?   @db.Timestamptz(3)
  /// Latest `queued` event; closes an approval wait (with startedAt and completedAt).
  lastQueuedAt     DateTime?   @db.Timestamptz(3)
  /// Approval wait, excluded from queue time.
  waitingS         Int         @default(0)
  startedAt        DateTime?   @db.Timestamptz(3)
  completedAt      DateTime?   @db.Timestamptz(3)
  queueS           Int?
  durationS        Int?
  /// Multiplied minutes (design 6.6); 0 for self-hosted, public standard hosted and unknown.
  billableMinEst   Int?
  source           Source
  lastEventAt      DateTime    @db.Timestamptz(3)

  @@index([installationId, completedAt])
  @@index([repositoryId, workflowId, completedAt])
  @@index([runId])
  @@index([installationId, runnerName, startedAt])
}

// ---------- rollups (kept forever; histograms are int[80], see metrics/histogram.ts) ----------

/// A (repository, day) whose rollups must be recomputed. Days are in Installation.timezone.
model RollupDirty {
  installationId BigInt
  repositoryId   BigInt
  day            DateTime @db.Date
  markedAt       DateTime @db.Timestamptz(3)

  @@id([installationId, repositoryId, day])
}

model DailyWorkflowStat {
  installationId       BigInt
  repositoryId         BigInt
  /// 0 for runs whose workflow is unknown (placeholders).
  workflowId           BigInt
  workflowName         String
  day                  DateTime @db.Date
  defaultBranch        Boolean
  runs                 Int
  success              Int
  /// failure + timed_out + startup_failure
  failure              Int
  cancelled            Int
  /// skipped, neutral, action_required, stale
  other                Int
  firstTrySuccess      Int
  flakyRecovered       Int
  durSumS              BigInt
  durHist              Int[]
  /// Per-run queue time of the first job to start.
  queueHist            Int[]
  jobSecondsLinux      Int
  jobSecondsWindows    Int
  jobSecondsMacos      Int
  jobSecondsSelfHosted Int
  billableMinEst       Int

  @@id([workflowId, day, defaultBranch])
  @@index([installationId, day])
  @@index([repositoryId, day])
}

model DailyJobStat {
  installationId BigInt
  repositoryId   BigInt
  workflowId     BigInt
  baseName       String
  labelKey       String
  runnerKind     RunnerKind
  day            DateTime   @db.Date
  jobs           Int
  success        Int
  failure        Int
  durSumS        BigInt
  durHist        Int[]
  queueHist      Int[]
  billableMinEst Int

  @@id([workflowId, baseName, labelKey, runnerKind, day])
  @@index([installationId, day])
}

// ---------- runners (M2) ----------
//
// Runners are a cache of GitHub's runner lists (org and repo level), refreshed
// by reconcile step f and lazily by /runners views. Samples are kept 30 days
// and feed utilisation (design §6.5).

enum RunnerScope {
  ORG
  REPO
}

model Runner {
  /// "<installationId>:<ORG|REPO>:<githubRunnerId>"
  key            String      @id
  installationId BigInt
  scope          RunnerScope
  /// Set for REPO runners.
  repositoryId   BigInt?
  githubRunnerId BigInt
  name           String
  os             String
  /// Lowercase, sorted (as WorkflowJob.labels).
  labels         String[]
  groupName      String?
  online         Boolean
  busy           Boolean
  /// Reported by GitHub, or inferred: seen for a single job and then removed.
  ephemeral      Boolean     @default(false)
  firstSeenAt    DateTime    @db.Timestamptz(3)
  lastSeenAt     DateTime    @db.Timestamptz(3)
  lastOnlineAt   DateTime?   @db.Timestamptz(3)
  removedAt      DateTime?   @db.Timestamptz(3)

  @@index([installationId, removedAt])
  @@index([installationId, name])
  /// labels @> job labels (STUCK and no-matching-runner checks).
  @@index([labels], type: Gin, map: "Runner_labels_gin_idx")
}

/// One observation of a runner. intervalS = seconds since the previous sample,
/// capped at twice the target interval, so a gap does not count as online.
model RunnerSample {
  installationId BigInt
  runnerKey      String
  sampledAt      DateTime @db.Timestamptz(3)
  online         Boolean
  busy           Boolean
  intervalS      Int

  @@id([runnerKey, sampledAt])
  @@index([installationId, sampledAt])
}

model DailyRunnerStat {
  installationId  BigInt
  /// "shr:<repositoryId>:<runnerName>" (repo runner), "sh:<runnerName>" or "pool:<labelKey>"
  runnerKey       String
  runnerKind      RunnerKind
  day             DateTime   @db.Date
  jobs            Int
  failures        Int
  /// failure or startup_failure with a duration under 10 s, or the runner was removed mid-job.
  infraFailures   Int        @default(0)
  busyS           BigInt
  /// From RunnerSample plus job intervals; null for hosted pools.
  onlineS         BigInt?
  peakConcurrency Int
  durHist         Int[]
  queueHist       Int[]
  speedIndex      Float?

  @@id([installationId, runnerKey, day])
  @@index([installationId, day])
}

// ---------- costs ----------

/// One row of GitHub's enhanced billing usage report (per day, product, SKU, repository).
model BillingUsageItem {
  installationId     BigInt
  date               DateTime @db.Date
  product            String
  sku                String
  /// "" when the item is not attributed to a repository.
  repositoryFullName String   @default("")
  unitType           String
  quantity           Decimal  @db.Decimal(18, 4)
  pricePerUnit       Decimal  @db.Decimal(18, 6)
  grossAmount        Decimal  @db.Decimal(18, 6)
  discountAmount     Decimal  @db.Decimal(18, 6)
  netAmount          Decimal  @db.Decimal(18, 6)
  fetchedAt          DateTime @db.Timestamptz(3)

  @@id([installationId, date, product, sku, repositoryFullName])
}

enum GitHubCredentialKind {
  PAT
  USER_TO_SERVER
}

/// Personal-account billing credential (optional, design §3.4), one per USER
/// installation. Tokens are ciphertext "v1:<keyId>:<iv>:<ct>:<tag>" bound to
/// the row and column; GITHUB_BILLING_TOKEN from env is never written here.
model GitHubCredential {
  installationId        BigInt               @id
  kind                  GitHubCredentialKind
  githubUserId          BigInt
  /// Must equal Installation.accountLogin.
  githubLogin           String
  /// Ciphertext; null after a revocation (reconnect required).
  accessToken           String?
  accessTokenExpiresAt  DateTime?            @db.Timestamptz(3)
  /// Ciphertext; USER_TO_SERVER only, rotated on every refresh.
  refreshToken          String?
  refreshTokenExpiresAt DateTime?            @db.Timestamptz(3)
  /// App user who stored or connected it.
  createdByUserId       String
  lastUsedAt            DateTime?            @db.Timestamptz(3)
  lastRefreshedAt       DateTime?            @db.Timestamptz(3)
  /// Set by github_app_authorization.revoked or a rejected refresh token.
  revokedAt             DateTime?            @db.Timestamptz(3)
  lastError             String?
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  @@index([githubUserId])
}

/// Seeded from prisma/seed/sku-rates.json (idempotent, on reconcile); editable by admins.
model SkuRate {
  sku               String
  os                RunnerOs
  cores             Int?
  /// Regex for larger-runner labels.
  labelPattern      String?
  minuteMultiplier  Decimal  @db.Decimal(8, 3)
  pricePerMinuteUsd Decimal  @db.Decimal(10, 4)
  effectiveFrom     DateTime @db.Date

  @@id([sku, effectiveFrom])
}

// ---------- ingestion & ops ----------

/// Instance-wide reconcile state, e.g. the GitHub hook delivery log cursor.
model AppState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// GitHub rate budget per installation (0 = App JWT), from response headers.
model InstallationRateLimit {
  installationId BigInt
  /// core | graphql
  resource       String
  limit          Int
  remaining      Int
  resetAt        DateTime @db.Timestamptz(3)
  updatedAt      DateTime @db.Timestamptz(3)

  @@id([installationId, resource])
}

enum DeliveryStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD
  SKIPPED
  REJECTED
}

model WebhookDelivery {
  /// X-GitHub-Delivery
  id             String         @id
  event          String
  action         String?
  installationId BigInt?
  repositoryId   BigInt?
  payloadBytes   Int
  /// Nulled on PROCESSED/SKIPPED; kept 7 days for FAILED/DEAD.
  payload        Json?
  status         DeliveryStatus
  attempts       Int            @default(0)
  lockedUntil    DateTime?      @db.Timestamptz(3)
  /// Truncated and redacted.
  error          String?
  receivedAt     DateTime       @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?      @db.Timestamptz(3)

  @@index([status, receivedAt])
  @@index([installationId, receivedAt])
}

/// Mutation (per user) and sign-in (per IP hash) token buckets.
model RateLimitBucket {
  /// "action:<userId>" | "login:<ipHash>"
  key       String   @id
  tokens    Float
  updatedAt DateTime @db.Timestamptz(3)
}

// ---------- audit ----------

enum AuditAction {
  RUN_RERUN
  RUN_RERUN_FAILED
  RUN_CANCEL
  RUN_FORCE_CANCEL
  VAR_CREATE
  VAR_UPDATE
  VAR_DELETE
  VAR_BULK
  VAR_BULK_REVERT
  ORG_VAR_CREATE
  ORG_VAR_UPDATE
  ORG_VAR_DELETE
  PR_MERGE
  PR_BULK_MERGE
  SYNC_NOW
  MANAGEMENT_TOGGLE
  SETTINGS_UPDATE
  DATA_PURGE
  DELIVERY_REPLAY
  ROLE_UPDATE
  USER_DISABLE
  USER_ENABLE
  SKU_RATE_UPDATE
  BILLING_CREDENTIAL_SET
  BILLING_CREDENTIAL_CONNECT
  BILLING_CREDENTIAL_REVOKE
}

enum AuditStatus {
  PENDING
  SUCCEEDED
  FAILED
  DENIED
}

/// Append-only, hash-chained per installation (0 = instance-level chain).
model AuditLog {
  id              String      @id @default(cuid())
  seq             BigInt      @default(autoincrement())
  installationId  BigInt
  /// The app user who triggered the action.
  actorUserId     String
  /// Snapshot of name or email at the time of the action.
  actorDisplay    String
  actorRole       AppRole
  /// "oidc" | "github"
  actorProvider   String
  /// GitHub identity that performed it, e.g. "app:<slug>[bot]".
  actingAs        String?
  action          AuditAction
  repositoryId    BigInt?
  repoFullName    String?
  targetType      String
  targetId        String
  batchId         String?
  params          Json
  confirmation    String
  idempotencyKey  String      @unique
  status          AuditStatus
  httpStatus      Int?
  githubRequestId String?
  error           String?
  ipHash          String?
  userAgent       String?
  prevHash        String
  hash            String
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?   @db.Timestamptz(3)

  @@index([installationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt])
  @@index([batchId])
}
