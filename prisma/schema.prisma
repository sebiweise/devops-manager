// DevOps Manager database schema (milestone M0).
//
// Conventions:
// - GitHub ids are BigInt and are serialised as strings in DTOs.
// - Timestamps are timestamptz(3).
// - Every tenant table has an installationId column, and every tenant index
//   leads with it. Tenant data is only read through src/server/data.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- better-auth (users, sessions, accounts) ----------

enum AppRole {
  VIEWER
  OPERATOR
  ADMIN
}

model User {
  id             String    @id
  name           String
  /// From the OIDC provider or GitHub (verified primary email).
  email          String    @unique
  emailVerified  Boolean   @default(false)
  /// Not rendered (CSP); initials are shown instead.
  image          String?
  /// null = DEFAULT_LOCALE
  locale         String?
  /// Snapshot of the OIDC groups claim at the last OIDC sign-in.
  oidcGroups     String[]  @default([])
  /// Resolved from the env allowlists at the last sign-in.
  envRole        AppRole?
  /// Set by an admin (M4). Effective role = max(envRole, roleOverride).
  roleOverride   AppRole?
  roleOverrideBy String?
  roleOverrideAt DateTime? @db.Timestamptz(3)
  /// Ignored for env-assigned roles (break-glass).
  disabledAt     DateTime? @db.Timestamptz(3)
  lastLoginAt    DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

/// providerId is "oidc" or "github"; accountId is the provider's subject.
/// accessToken, refreshToken and idToken are dropped by the account hook
/// (src/server/better-auth/hooks.ts): they are not needed after sign-in.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// ---------- tenancy ----------

enum AccountType {
  USER
  ORGANIZATION
}

enum RepoSelection {
  ALL
  SELECTED
}

model Installation {
  /// GitHub installation id
  id                   BigInt        @id
  accountId            BigInt
  accountLogin         String        @unique
  accountType          AccountType
  repositorySelection  RepoSelection
  /// Granted permissions, as reported by GitHub.
  permissions          Json
  events               String[]
  permissionsCheckedAt DateTime?     @db.Timestamptz(3)
  /// Per-installation management toggle (admin only), off by default.
  managementEnabled    Boolean       @default(false)
  /// Variable values are masked for viewers and operators and stored in the
  /// audit log only as sha256 and length (plus a sealed copy for revert).
  redactVariableValues Boolean       @default(false)
  timezone             String        @default("UTC")
  /// 14..400, capped by MAX_RETENTION_DAYS.
  rawRetentionDays     Int           @default(90)
  includedMinutes      Int?
  planName             String?
  suspendedAt          DateTime?     @db.Timestamptz(3)
  deletedAt            DateTime?     @db.Timestamptz(3)
  purgeAfter           DateTime?     @db.Timestamptz(3)
  lastWebhookAt        DateTime?     @db.Timestamptz(3)
  lastReconciledAt     DateTime?     @db.Timestamptz(3)
  /// Column lock (PgBouncer-safe, no advisory locks).
  reconcileLockedUntil DateTime?     @db.Timestamptz(3)
  /// Outcome of the last reconcile of this installation: ok | partial | skipped | error.
  lastReconcileStatus  String?
  /// Why the last reconcile was not ok (redacted), shown on the sync health page.
  lastReconcileReason  String?
  hookDeliveryCursor   String?
  /// Last daily prune of this installation's raw history (reconcile step i).
  lastPrunedAt         DateTime?     @db.Timestamptz(3)
  /// Last "Sync now" (operator), rate-limited to once per 5 minutes.
  syncRequestedAt      DateTime?     @db.Timestamptz(3)
  /// Last runner sample (reconcile step f or a lazy /runners view, at most every 2 min).
  runnersSampledAt     DateTime?     @db.Timestamptz(3)
  /// Last daily discovery pass over the repo-level runners of every active repo.
  runnersDiscoveredAt  DateTime?     @db.Timestamptz(3)
  /// Last billing sync (reconcile step h, once a day).
  billingSyncedAt      DateTime?     @db.Timestamptz(3)
  /// ok | no_permission | no_credential | unavailable | credential_error
  billingStatus        String?
  /// Truncated and redacted; never contains a token.
  billingError         String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)

  repositories Repository[]
  vercel       VercelConnection?
  azure        AzureDevOpsConnection?
}

// ---------- inventory ----------

model Repository {
  /// GitHub repository id
  id                 BigInt       @id
  installationId     BigInt
  installation       Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  ownerLogin         String
  name               String
  fullName           String
  private            Boolean
  archived           Boolean      @default(false)
  defaultBranch      String       @default("main")
  /// Set when a SELF_HOSTED job is seen (M1).
  hasSelfHosted      Boolean      @default(false)
  /// GitHub's `fork` flag, from the inventory (REST lists and repository events).
  fork               Boolean      @default(false)
  /// Set by REPO_IGNORE; null = active. An ignored repo gets no sync, backfill,
  /// runner sampling or webhook folds, and its stored data is purged. Kept
  /// across removedAt and re-adds (the row keeps its id); the inventory never
  /// writes it.
  ignoredAt          DateTime?    @db.Timestamptz(3)
  ignoredByUserId    String?
  /// Set when the purge of the repo's stored data finished; cleared on un-ignore.
  ignorePurgedAt     DateTime?    @db.Timestamptz(3)
  /// Cached open pull request and Dependabot alert counts (null = not read yet).
  openPrCount        Int?
  openAlertCount     Int?
  /// Open alerts with severity high or critical.
  openAlertHighCount Int?
  countsRefreshedAt  DateTime?    @db.Timestamptz(3)
  removedAt          DateTime?    @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)

  vercelProjects         VercelProject[]
  azureDefinitions       AzurePipelineDefinition[] @relation("AzureDefinitionRepo")
  azureManualDefinitions AzurePipelineDefinition[] @relation("AzureDefinitionManualRepo")

  @@unique([installationId, fullName])
  @@index([installationId, removedAt])
  @@index([installationId, ignoredAt])
}

model SyncState {
  repositoryId   BigInt    @id
  installationId BigInt
  /// Incremental sync high-water mark.
  runsCursor     DateTime? @db.Timestamptz(3)
  /// Oldest window covered so far.
  backfillUntil  DateTime? @db.Timestamptz(3)
  backfillDone   Boolean   @default(false)
  runsEtag       String?
  /// e.g. after an oversized (413) delivery
  needsResync    Boolean   @default(false)
  lastError      String?
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([installationId])
}

// ---------- Actions history (M1) ----------
//
// Runs and jobs are folded order-independently (src/server/ingest/fold.ts):
// any permutation or duplication of the same events yields the same row.
// Raw SQL in the migration adds partial indexes for open runs and queued jobs.

enum RunStatus {
  REQUESTED
  QUEUED
  WAITING
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum JobStatus {
  QUEUED
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum Conclusion {
  SUCCESS
  FAILURE
  CANCELLED
  SKIPPED
  TIMED_OUT
  ACTION_REQUIRED
  NEUTRAL
  STALE
  STARTUP_FAILURE
}

enum RunnerKind {
  GITHUB_HOSTED
  LARGER_HOSTED
  SELF_HOSTED
  UNKNOWN
}

enum RunnerOs {
  LINUX
  WINDOWS
  MACOS
  UNKNOWN
}

enum Source {
  WEBHOOK
  BACKFILL
  RECONCILE
}

model WorkflowRun {
  /// GitHub run id
  id                     BigInt      @id
  installationId         BigInt
  repositoryId           BigInt
  workflowId             BigInt?
  workflowName           String
  workflowPath           String?
  event                  String?
  headBranch             String?
  headSha                String
  isDefaultBranch        Boolean     @default(false)
  actorLogin             String?
  runNumber              Int?
  /// Latest attempt.
  runAttempt             Int         @default(1)
  /// Conclusion of attempt 1, for flakiness.
  firstAttemptConclusion Conclusion?
  status                 RunStatus
  /// requested/queued/pending = 1, waiting = 2, in_progress = 3, completed = 4; 0 = placeholder.
  statusRank             Int         @db.SmallInt
  conclusion             Conclusion?
  createdAt              DateTime    @db.Timestamptz(3)
  runStartedAt           DateTime?   @db.Timestamptz(3)
  completedAt            DateTime?   @db.Timestamptz(3)
  durationS              Int?
  /// Created from a job before its run arrived.
  isPlaceholder          Boolean     @default(false)
  htmlUrl                String?
  /// GitHub's updated_at; jobs are re-read when it is newer than jobsSyncedAt.
  githubUpdatedAt        DateTime?   @db.Timestamptz(3)
  jobsSyncedAt           DateTime?   @db.Timestamptz(3)
  source                 Source
  lastEventAt            DateTime    @db.Timestamptz(3)

  @@index([installationId, createdAt(sort: Desc)])
  @@index([repositoryId, createdAt(sort: Desc)])
  @@index([repositoryId, workflowId, createdAt])
}

model WorkflowJob {
  /// GitHub job id (one per attempt)
  id               BigInt      @id
  runId            BigInt
  runAttempt       Int
  installationId   BigInt
  repositoryId     BigInt
  workflowId       BigInt?
  workflowName     String
  name             String
  /// Matrix suffix " (..)" stripped.
  baseName         String
  /// First write, sorted, lowercase.
  labels           String[]
  /// Sorted labels joined by ",".
  labelKey         String
  status           JobStatus
  /// queued = 1, waiting = 2, in_progress = 3, completed = 4.
  statusRank       Int         @db.SmallInt
  conclusion       Conclusion?
  runnerId         BigInt?
  runnerName       String?
  runnerGroupId    BigInt?
  runnerGroupName  String?
  runnerKind       RunnerKind  @default(UNKNOWN)
  runnerOs         RunnerOs    @default(UNKNOWN)
  /// e.g. "linux", "windows", "macos", "linux_4_core"
  sku              String?
  createdAt        DateTime    @db.Timestamptz(3)
  /// Environment approval: first `waiting` event.
  waitingStartedAt DateTime?   @db.Timestamptz(3)
  /// Latest `queued` event; closes an approval wait (with startedAt and completedAt).
  lastQueuedAt     DateTime?   @db.Timestamptz(3)
  /// Approval wait, excluded from queue time.
  waitingS         Int         @default(0)
  startedAt        DateTime?   @db.Timestamptz(3)
  completedAt      DateTime?   @db.Timestamptz(3)
  queueS           Int?
  durationS        Int?
  /// Multiplied minutes (design 6.6); 0 for self-hosted, public standard hosted and unknown.
  billableMinEst   Int?
  source           Source
  lastEventAt      DateTime    @db.Timestamptz(3)

  @@index([installationId, completedAt])
  @@index([repositoryId, workflowId, completedAt])
  @@index([runId])
  @@index([installationId, runnerName, startedAt])
}

// ---------- rollups (kept forever; histograms are int[80], see metrics/histogram.ts) ----------

/// A (repository, day) whose rollups must be recomputed. Days are in Installation.timezone.
model RollupDirty {
  installationId BigInt
  repositoryId   BigInt
  day            DateTime @db.Date
  markedAt       DateTime @db.Timestamptz(3)

  @@id([installationId, repositoryId, day])
}

model DailyWorkflowStat {
  installationId       BigInt
  repositoryId         BigInt
  /// 0 for runs whose workflow is unknown (placeholders).
  workflowId           BigInt
  workflowName         String
  day                  DateTime @db.Date
  defaultBranch        Boolean
  runs                 Int
  success              Int
  /// failure + timed_out + startup_failure
  failure              Int
  cancelled            Int
  /// skipped, neutral, action_required, stale
  other                Int
  firstTrySuccess      Int
  flakyRecovered       Int
  durSumS              BigInt
  durHist              Int[]
  /// Per-run queue time of the first job to start.
  queueHist            Int[]
  jobSecondsLinux      Int
  jobSecondsWindows    Int
  jobSecondsMacos      Int
  jobSecondsSelfHosted Int
  billableMinEst       Int

  @@id([workflowId, day, defaultBranch])
  @@index([installationId, day])
  @@index([repositoryId, day])
}

model DailyJobStat {
  installationId BigInt
  repositoryId   BigInt
  workflowId     BigInt
  baseName       String
  labelKey       String
  runnerKind     RunnerKind
  day            DateTime   @db.Date
  jobs           Int
  success        Int
  failure        Int
  durSumS        BigInt
  durHist        Int[]
  queueHist      Int[]
  billableMinEst Int

  @@id([workflowId, baseName, labelKey, runnerKind, day])
  @@index([installationId, day])
}

// ---------- runners (M2) ----------
//
// Runners are a cache of GitHub's runner lists (org and repo level), refreshed
// by reconcile step f and lazily by /runners views. Samples are kept 30 days
// and feed utilisation (design §6.5).

enum RunnerScope {
  ORG
  REPO
}

model Runner {
  /// "<installationId>:<ORG|REPO>:<githubRunnerId>"
  key            String      @id
  installationId BigInt
  scope          RunnerScope
  /// Set for REPO runners.
  repositoryId   BigInt?
  githubRunnerId BigInt
  name           String
  os             String
  /// Lowercase, sorted (as WorkflowJob.labels).
  labels         String[]
  groupName      String?
  online         Boolean
  busy           Boolean
  /// Reported by GitHub, or inferred: seen for a single job and then removed.
  ephemeral      Boolean     @default(false)
  firstSeenAt    DateTime    @db.Timestamptz(3)
  lastSeenAt     DateTime    @db.Timestamptz(3)
  lastOnlineAt   DateTime?   @db.Timestamptz(3)
  removedAt      DateTime?   @db.Timestamptz(3)

  @@index([installationId, removedAt])
  @@index([installationId, name])
  /// labels @> job labels (STUCK and no-matching-runner checks).
  @@index([labels], type: Gin, map: "Runner_labels_gin_idx")
}

/// One observation of a runner. intervalS = seconds since the previous sample,
/// capped at twice the target interval, so a gap does not count as online.
model RunnerSample {
  installationId BigInt
  runnerKey      String
  sampledAt      DateTime @db.Timestamptz(3)
  online         Boolean
  busy           Boolean
  intervalS      Int

  @@id([runnerKey, sampledAt])
  @@index([installationId, sampledAt])
}

model DailyRunnerStat {
  installationId  BigInt
  /// "shr:<repositoryId>:<runnerName>" (repo runner), "sh:<runnerName>" or "pool:<labelKey>"
  runnerKey       String
  runnerKind      RunnerKind
  day             DateTime   @db.Date
  jobs            Int
  failures        Int
  /// failure or startup_failure with a duration under 10 s, or the runner was removed mid-job.
  infraFailures   Int        @default(0)
  busyS           BigInt
  /// From RunnerSample plus job intervals; null for hosted pools.
  onlineS         BigInt?
  peakConcurrency Int
  durHist         Int[]
  queueHist       Int[]
  speedIndex      Float?

  @@id([installationId, runnerKey, day])
  @@index([installationId, day])
}

// ---------- costs ----------

/// One row of GitHub's enhanced billing usage report (per day, product, SKU, repository).
model BillingUsageItem {
  installationId     BigInt
  date               DateTime @db.Date
  product            String
  sku                String
  /// "" when the item is not attributed to a repository.
  repositoryFullName String   @default("")
  unitType           String
  quantity           Decimal  @db.Decimal(18, 4)
  pricePerUnit       Decimal  @db.Decimal(18, 6)
  grossAmount        Decimal  @db.Decimal(18, 6)
  discountAmount     Decimal  @db.Decimal(18, 6)
  netAmount          Decimal  @db.Decimal(18, 6)
  fetchedAt          DateTime @db.Timestamptz(3)

  @@id([installationId, date, product, sku, repositoryFullName])
}

enum GitHubCredentialKind {
  PAT
  USER_TO_SERVER
}

/// Personal-account billing credential (optional, design §3.4), one per USER
/// installation. Tokens are ciphertext "v1:<keyId>:<iv>:<ct>:<tag>" bound to
/// the row and column; GITHUB_BILLING_TOKEN from env is never written here.
model GitHubCredential {
  installationId        BigInt               @id
  kind                  GitHubCredentialKind
  githubUserId          BigInt
  /// Must equal Installation.accountLogin.
  githubLogin           String
  /// Ciphertext; null after a revocation (reconnect required).
  accessToken           String?
  accessTokenExpiresAt  DateTime?            @db.Timestamptz(3)
  /// Ciphertext; USER_TO_SERVER only, rotated on every refresh.
  refreshToken          String?
  refreshTokenExpiresAt DateTime?            @db.Timestamptz(3)
  /// App user who stored or connected it.
  createdByUserId       String
  lastUsedAt            DateTime?            @db.Timestamptz(3)
  lastRefreshedAt       DateTime?            @db.Timestamptz(3)
  /// Set by github_app_authorization.revoked or a rejected refresh token.
  revokedAt             DateTime?            @db.Timestamptz(3)
  lastError             String?
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)

  @@index([githubUserId])
}

/// Seeded from prisma/seed/sku-rates.json (idempotent, on reconcile); editable by admins.
model SkuRate {
  sku               String
  os                RunnerOs
  cores             Int?
  /// Regex for larger-runner labels.
  labelPattern      String?
  minuteMultiplier  Decimal  @db.Decimal(8, 3)
  pricePerMinuteUsd Decimal  @db.Decimal(10, 4)
  effectiveFrom     DateTime @db.Date

  @@id([sku, effectiveFrom])
}

// ---------- ingestion & ops ----------

/// Instance-wide reconcile state, e.g. the GitHub hook delivery log cursor.
model AppState {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// GitHub rate budget per installation (0 = App JWT), from response headers.
model InstallationRateLimit {
  installationId BigInt
  /// core | graphql
  resource       String
  limit          Int
  remaining      Int
  resetAt        DateTime @db.Timestamptz(3)
  updatedAt      DateTime @db.Timestamptz(3)

  @@id([installationId, resource])
}

enum DeliveryStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD
  SKIPPED
  REJECTED
}

model WebhookDelivery {
  /// X-GitHub-Delivery; Azure DevOps service hook deliveries use "azure:<notificationId>".
  id             String         @id
  /// github | azure. Together with the id prefix the dedupe key is (provider, deliveryId).
  provider       String         @default("github")
  event          String
  action         String?
  installationId BigInt?
  repositoryId   BigInt?
  payloadBytes   Int
  /// Nulled on PROCESSED/SKIPPED; kept 7 days for FAILED/DEAD.
  payload        Json?
  status         DeliveryStatus
  attempts       Int            @default(0)
  lockedUntil    DateTime?      @db.Timestamptz(3)
  /// Truncated and redacted.
  error          String?
  receivedAt     DateTime       @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?      @db.Timestamptz(3)

  @@index([status, receivedAt])
  @@index([installationId, receivedAt])
}

/// Mutation (per user) and sign-in (per IP hash) token buckets.
model RateLimitBucket {
  /// "action:<userId>" | "login:<ipHash>"
  key       String   @id
  tokens    Float
  updatedAt DateTime @db.Timestamptz(3)
}

// ---------- audit ----------

enum AuditAction {
  RUN_RERUN
  RUN_RERUN_FAILED
  RUN_CANCEL
  RUN_FORCE_CANCEL
  VAR_CREATE
  VAR_UPDATE
  VAR_DELETE
  VAR_BULK
  VAR_BULK_REVERT
  ORG_VAR_CREATE
  ORG_VAR_UPDATE
  ORG_VAR_DELETE
  PR_MERGE
  PR_BULK_MERGE
  SYNC_NOW
  MANAGEMENT_TOGGLE
  SETTINGS_UPDATE
  DATA_PURGE
  DELIVERY_REPLAY
  ROLE_UPDATE
  USER_DISABLE
  USER_ENABLE
  SKU_RATE_UPDATE
  BILLING_CREDENTIAL_SET
  BILLING_CREDENTIAL_CONNECT
  BILLING_CREDENTIAL_REVOKE
  REPO_IGNORE
  REPO_UNIGNORE
  VERCEL_CONNECT
  VERCEL_TOKEN_ROTATE
  VERCEL_DISCONNECT
  VERCEL_PROJECT_LINK
  VERCEL_MANAGEMENT_TOGGLE
  VERCEL_REDEPLOY
  VERCEL_CANCEL
  VERCEL_PROMOTE
  VERCEL_ROLLBACK
  ADO_CONNECT
  ADO_TOKEN_ROTATE
  ADO_DISCONNECT
  ADO_PROJECTS_SELECT
  ADO_DEFINITION_LINK
  ADO_DEFINITION_OS_SET
  ADO_LIMITS_UPDATE
  ADO_HOOKS_INSTALL
  ADO_HOOK_SECRET_ROTATE
  ADO_MANAGEMENT_TOGGLE
  ADO_QUEUE_RUN
  ADO_CANCEL
  ADO_RETRY
  ADO_STAGE_RETRY
}

enum AuditStatus {
  PENDING
  SUCCEEDED
  FAILED
  DENIED
}

/// Append-only, hash-chained per installation (0 = instance-level chain).
model AuditLog {
  id              String      @id @default(cuid())
  seq             BigInt      @default(autoincrement())
  installationId  BigInt
  /// The app user who triggered the action.
  actorUserId     String
  /// Snapshot of name or email at the time of the action.
  actorDisplay    String
  actorRole       AppRole
  /// "oidc" | "github"
  actorProvider   String
  /// GitHub identity that performed it, e.g. "app:<slug>[bot]".
  actingAs        String?
  action          AuditAction
  repositoryId    BigInt?
  repoFullName    String?
  targetType      String
  targetId        String
  batchId         String?
  params          Json
  confirmation    String
  idempotencyKey  String      @unique
  status          AuditStatus
  httpStatus      Int?
  githubRequestId String?
  error           String?
  ipHash          String?
  userAgent       String?
  prevHash        String
  hash            String
  /// sha256(canonical(final status fields) || hash), written with the final
  /// status, so a changed outcome is detected by Verify as well.
  resultHash      String?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?   @db.Timestamptz(3)

  @@index([installationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt])
  @@index([batchId])
}

/// The newest row of each audit chain (design §9 "Audit"), kept outside
/// AuditLog so Verify detects removed rows at the end of a chain. Written in
/// the same transaction as the row; a trigger (see the migration) lets it
/// only move forward and forbids deleting it.
model AuditChainHead {
  /// 0 = the instance-level chain.
  installationId BigInt   @id
  seq            BigInt
  hash           String
  /// Final rows with a higher seq must carry a result hash; rows up to it
  /// were written before results were sealed (M3).
  sealedAfterSeq BigInt
  updatedAt      DateTime @db.Timestamptz(3)
}

// ---------- hosting: Vercel (M5 read-only, M6 actions) ----------
//
// One Vercel team per GitHub installation (1:1). Every table carries
// installationId and its indexes lead with it. Env var values, Vercel user
// names and build logs are never stored. Tenant reads go through
// src/server/data/vercel.ts; see docs/VERCEL.md.

enum VercelTokenSource {
  DB
  ENV
}

model VercelConnection {
  installationId      BigInt            @id
  installation        Installation      @relation(fields: [installationId], references: [id], onDelete: Cascade)
  /// Unique across the instance: a team belongs to one installation only.
  teamId              String            @unique
  teamSlug            String
  teamName            String
  /// "hobby" | "pro" | "enterprise" (GET /v2/teams/{id} billing.plan)
  plan                String?
  tokenSource         VercelTokenSource
  /// Ciphertext, AAD "VercelConnection:<installationId>:accessToken"; null for ENV.
  accessToken         String?
  /// Last 4 characters of the token.
  tokenHint           String?
  /// "team" (scoped to this team) | "full" (every team of the user) | null (unknown)
  tokenScope          String?
  tokenExpiresAt      DateTime?         @db.Timestamptz(3)
  /// Separate Vercel management toggle (M6), off by default.
  managementEnabled   Boolean           @default(false)
  createdByUserId     String
  /// Written at most every 10 minutes.
  lastUsedAt          DateTime?         @db.Timestamptz(3)
  /// Set on 401 or 403 invalidToken/missingToken; sync stops until a rotate.
  revokedAt           DateTime?         @db.Timestamptz(3)
  /// Redacted and truncated; never contains a token.
  lastError           String?
  /// ok | partial | rate_limited | credential_error | error
  lastSyncStatus      String?
  lastSyncedAt        DateTime?         @db.Timestamptz(3)
  projectsSyncedAt    DateTime?         @db.Timestamptz(3)
  /// No Vercel call before this time (the retry time of a 429).
  pausedUntil         DateTime?         @db.Timestamptz(3)
  /// ms epoch of the newest deployment createdAt of the last complete pass.
  deploymentsCursor   BigInt?
  /// Resume point (pagination.next) inside an unfinished pass.
  deploymentsPageNext BigInt?
  /// Newest createdAt seen by the unfinished pass; becomes the cursor when it completes.
  deploymentsPassTop  BigInt?
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  projects    VercelProject[]
  deployments VercelDeployment[]
}

model VercelProject {
  /// prj_...
  id                     String           @id
  installationId         BigInt
  connection             VercelConnection @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  name                   String
  framework              String?
  /// github | gitlab | bitbucket | null (CLI deployments)
  linkType               String?
  /// GitHub repository id from the project link; never joined on its own.
  linkRepoId             BigInt?
  /// "owner/name" from the link, display only.
  linkRepo               String?
  productionBranch       String?
  /// Resolved from linkRepoId: same installation, not removed, not ignored.
  repositoryId           BigInt?
  repository             Repository?      @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  /// Admin override (VERCEL_PROJECT_LINK), validated like repositoryId.
  manualRepositoryId     BigInt?
  /// Newest production-target deployment and its state.
  latestProdDeploymentId String?
  latestProdState        String?
  latestProdReadyAt      DateTime?        @db.Timestamptz(3)
  /// The deployment production traffic is served from (targets.production).
  liveProdDeploymentId   String?
  /// Set while production is pinned to an older deployment (rollback); cleared by a promote or when the newest one is live.
  autoAssignPausedAt     DateTime?        @db.Timestamptz(3)
  /// The last promote or rollback request (GET /v9/projects/{id}?rollbackInfo=true lastAliasRequest), read after an M6 action.
  /// "promote" | "rollback"
  aliasRequestType       String?
  /// pending | in-progress | succeeded | failed | skipped
  aliasRequestStatus     String?
  aliasRequestAt         DateTime?        @db.Timestamptz(3)
  aliasToDeploymentId    String?
  /// Last read of this project from Vercel (v1 list or a targeted GET after a hint); the pause rule compares it with the newest ready production deployment.
  projectReadAt          DateTime?        @db.Timestamptz(3)
  /// Set by GitHub deployment_status hints; the next refresh clears it.
  dirtyAt                DateTime?        @db.Timestamptz(3)
  /// Last targeted refresh from a hint (debounced to 30 s).
  hintRefreshedAt        DateTime?        @db.Timestamptz(3)
  pausedAt               DateTime?        @db.Timestamptz(3)
  removedAt              DateTime?        @db.Timestamptz(3)
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)

  deployments VercelDeployment[]

  @@index([installationId, removedAt])
  @@index([installationId, repositoryId])
  @@index([installationId, manualRepositoryId])
  @@index([installationId, dirtyAt])
}

enum VercelDeploymentState {
  QUEUED
  INITIALIZING
  BUILDING
  READY
  ERROR
  CANCELED
  BLOCKED
  DELETED
  UNKNOWN
}

model VercelDeployment {
  /// dpl_...
  id                  String                @id
  installationId      BigInt
  connection          VercelConnection      @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  projectId           String
  project             VercelProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// production | preview | staging
  target              String
  state               VercelDeploymentState
  /// PROMOTED | ROLLING | STAGED (READY only)
  readySubstate       String?
  /// Hostname only.
  url                 String?
  branch              String?
  commitSha           String?
  /// First line, at most 200 characters.
  commitMessage       String?
  /// git | cli | api | redeploy | promote | rollback (never a user name)
  creatorKind         String?
  /// Vercel's error code of an ERROR deployment, e.g. BUILD_FAILED.
  errorCode           String?
  isRollbackCandidate Boolean               @default(false)
  /// The audit row of the M6 action that created it (redeploy).
  auditLogId          String?
  /// "exact" (meta.devopsManagerAudit) | "probable" (project, 2-minute window, creator kind redeploy)
  auditLinkKind       String?
  createdAt           DateTime              @db.Timestamptz(3)
  buildingAt          DateTime?             @db.Timestamptz(3)
  readyAt             DateTime?             @db.Timestamptz(3)
  buildMs             Int?
  syncedAt            DateTime              @db.Timestamptz(3)

  @@index([installationId, createdAt(sort: Desc)])
  @@index([installationId, projectId, createdAt(sort: Desc)])
  @@index([installationId, commitSha])
  @@index([installationId, state])
}

/// Deployments per project, local day (Installation.timezone) and target.
model DailyDeploymentStat {
  installationId BigInt
  projectId      String
  day            DateTime @db.Date
  target         String
  total          Int
  ready          Int
  error          Int
  canceled       Int
  buildMsP50     Int?
  buildMsP90     Int?

  @@id([installationId, projectId, day, target])
  @@index([installationId, day])
}

// ---------- CI: Azure DevOps / Azure Pipelines (M7, M7b actions, M7c SP) ----------
//
// One Azure DevOps organisation per GitHub installation (1:1, orgId unique).
// New tables only: the GitHub run, job, rollup, runner and cost tables are
// untouched. Every table carries installationId and its indexes lead with
// it. Identities, e-mail addresses and logs are never stored. Tenant reads
// go through src/server/data/azure.ts; see docs/AZURE-DEVOPS.md.

enum AzureAuthKind {
  /// Organisation-scoped personal access token (encrypted).
  PAT
  /// AZURE_DEVOPS_PAT or the AZURE_DEVOPS_* service principal from env (never stored).
  ENV
  /// Microsoft Entra service principal, client credentials (secret encrypted).
  ENTRA_SP
}

enum AzureBuildStatus {
  NOT_STARTED
  POSTPONED
  IN_PROGRESS
  CANCELLING
  COMPLETED
  UNKNOWN
}

enum AzureBuildResult {
  SUCCEEDED
  PARTIALLY_SUCCEEDED
  FAILED
  CANCELED
  NONE
}

enum AzureJobResult {
  SUCCEEDED
  SUCCEEDED_WITH_ISSUES
  FAILED
  CANCELED
  SKIPPED
  ABANDONED
  NONE
}

enum AzureOs {
  LINUX
  WINDOWS
  MACOS
  UNKNOWN
}

model AzureDevOpsConnection {
  installationId          BigInt        @id
  installation            Installation  @relation(fields: [installationId], references: [id], onDelete: Cascade)
  /// Organisation GUID (connectionData instanceId), or "name:<org>" when it is not readable.
  orgId                   String        @unique
  /// Plaintext (URL building, display); never in logs, error texts or audit params.
  orgName                 String
  authKind                AzureAuthKind
  /// Ciphertext: the PAT (PAT) or the client secret (ENTRA_SP), AAD "AzureDevOpsConnection:<id>:accessToken"; null for ENV.
  accessToken             String?
  /// Last 4 characters of the PAT or client secret.
  tokenHint               String?
  /// Admin-entered expiry of the PAT or client secret.
  tokenExpiresAt          DateTime?     @db.Timestamptz(3)
  /// ENTRA_SP: the directory (tenant) id and the application (client) id.
  tenantId                String?
  clientId                String?
  /// Capability probes: { projects, pools, builds, execute, hooks } = ok | missing | unknown.
  scopes                  Json          @default("{}")
  /// Separate Azure management toggle (M7b), off by default.
  managementEnabled       Boolean       @default(false)
  /// Random public route key of the service hook (/api/azure/hooks/<hookKey>).
  hookKey                 String?       @unique
  /// Ciphertext of the Basic-auth password of the service hook.
  hookSecret              String?
  hookSecretPrev          String?
  hookSecretPrevUntil     DateTime?     @db.Timestamptz(3)
  hookFailures            Int           @default(0)
  hookFailuresSince       DateTime?     @db.Timestamptz(3)
  hookBlockedUntil        DateTime?     @db.Timestamptz(3)
  /// GitHub App slug whose check runs are hints (the Azure Pipelines app).
  checkAppSlug            String        @default("azure-pipelines")
  /// Limits (admin-editable, ADO_LIMITS_UPDATE); the stored values are the source of truth.
  hostedParallelJobs      Int           @default(1)
  /// null = paid tier, no monthly minute limit.
  includedMinutes         Int?          @default(1800)
  /// 60 on the free tier, 360 on the paid tier.
  maxJobMinutes           Int           @default(60)
  /// Day of the month the minutes reset (assumed: calendar month).
  monthResetDay           Int           @default(1)
  blockWhenQuotaExhausted Boolean       @default(false)
  /// What resourceusage reported last: { totalMinutes, totalCount, isPremium }.
  detectedLimits          Json?
  createdByUserId         String
  /// Set on 401 or 203; sync stops until a rotate.
  revokedAt               DateTime?     @db.Timestamptz(3)
  /// No Azure DevOps call before this time (Retry-After, 429, TF400733, low headroom).
  pausedUntil             DateTime?     @db.Timestamptz(3)
  /// Redacted and truncated; never a token or the organisation name.
  lastError               String?
  /// ok | partial | rate_limited | credential_error | error
  lastSyncStatus          String?
  lastSyncedAt            DateTime?     @db.Timestamptz(3)
  /// Written at most every 10 minutes.
  lastUsedAt              DateTime?     @db.Timestamptz(3)
  definitionsSyncedAt     DateTime?     @db.Timestamptz(3)
  poolsSampledAt          DateTime?     @db.Timestamptz(3)
  usageSyncedAt           DateTime?     @db.Timestamptz(3)
  hooksCheckedAt          DateTime?     @db.Timestamptz(3)
  /// Last z2c finished-retry sweep (every 30 minutes).
  sweepAt                 DateTime?     @db.Timestamptz(3)
  /// The job request feed answered (false: usage is estimated from builds, labelled partial).
  jobRequestsAvailable    Boolean?
  createdAt               DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @db.Timestamptz(3)

  projects    AzureDevOpsProject[]
  definitions AzurePipelineDefinition[]
  builds      AzureBuild[]
}

model AzureDevOpsProject {
  installationId     BigInt
  connection         AzureDevOpsConnection @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  /// Project GUID.
  id                 String
  name               String
  /// private | public (separate free tiers)
  visibility         String
  selected           Boolean               @default(false)
  /// queueTime high-water mark of the last complete pass (z2b).
  buildsCursor       DateTime?             @db.Timestamptz(3)
  /// x-ms-continuationtoken inside an unfinished pass.
  buildsContinuation String?
  /// Newest queueTime seen by the unfinished pass; becomes the cursor when it completes.
  buildsPassTop      DateTime?             @db.Timestamptz(3)
  /// Backfill (z2d) continues below this queueTime.
  backfillBefore     DateTime?             @db.Timestamptz(3)
  backfillDone       Boolean               @default(false)
  removedAt          DateTime?             @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  @@id([installationId, id])
}

model AzurePipelineDefinition {
  installationId     BigInt
  connection         AzureDevOpsConnection @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  projectId          String
  id                 Int
  name               String
  /// Folder path of the definition.
  path               String?
  yamlPath           String?
  /// GitHub | TfsGit | ... (repository.type)
  repoType           String
  /// "owner/name" from the definition's repository, display only.
  linkRepoFullName   String?
  /// Resolved from linkRepoFullName: same installation, not removed, not ignored.
  repositoryId       BigInt?
  repository         Repository?           @relation("AzureDefinitionRepo", fields: [repositoryId], references: [id], onDelete: SetNull)
  /// Admin override (ADO_DEFINITION_LINK), validated like repositoryId.
  manualRepositoryId BigInt?
  manualRepository   Repository?           @relation("AzureDefinitionManualRepo", fields: [manualRepositoryId], references: [id], onDelete: SetNull)
  defaultBranch      String?
  /// enabled | paused | disabled
  queueStatus        String?
  /// Admin override of the OS of every job (ADO_DEFINITION_OS_SET).
  osOverride         AzureOs?
  /// Set by hints; the next pass reads its newest builds.
  dirtyAt            DateTime?             @db.Timestamptz(3)
  hintRefreshedAt    DateTime?             @db.Timestamptz(3)
  removedAt          DateTime?             @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  @@id([installationId, projectId, id])
  @@index([installationId, repositoryId])
  @@index([installationId, manualRepositoryId])
}

model AzureBuild {
  installationId     BigInt
  connection         AzureDevOpsConnection @relation(fields: [installationId], references: [installationId], onDelete: Cascade)
  /// Build (run) id, unique within the organisation.
  id                 Int
  projectId          String
  definitionId       Int
  /// The effective repository of its definition at write time.
  repositoryId       BigInt?
  buildNumber        String
  status             AzureBuildStatus
  result             AzureBuildResult
  /// Normalised: push | pull_request | schedule | workflow_dispatch | other (never a user name).
  reason             String
  headBranch         String?
  headSha            String?
  /// Pull request number from triggerInfo (secondary PR join).
  prNumber           Int?
  isDefaultBranch    Boolean               @default(false)
  queuedAt           DateTime              @db.Timestamptz(3)
  startedAt          DateTime?             @db.Timestamptz(3)
  finishedAt         DateTime?             @db.Timestamptz(3)
  durationS          Int?
  /// First job start minus queue time (or the job request's assign - queue).
  queueS             Int?
  queuePosition      Int?
  maxAttempt         Int                   @default(1)
  /// Result of attempt 1 (from the attempt-1 job records), for first-try and flakiness.
  firstAttemptResult AzureBuildResult?
  /// A job hit the job time limit.
  timedOut           Boolean               @default(false)
  /// lastChangedDate; snapshots older than the stored one are ignored.
  lastChangedAt      DateTime?             @db.Timestamptz(3)
  timelineSyncedAt   DateTime?             @db.Timestamptz(3)
  timelineChangeId   Int?
  /// Set by hints and hooks; z3 reads the timeline first.
  dirtyAt            DateTime?             @db.Timestamptz(3)
  hintRefreshedAt    DateTime?             @db.Timestamptz(3)
  /// The audit row of the M7b queue that created it.
  auditLogId         String?
  /// exact (dm-audit tag) | probable (definition, manual, ref, 2-minute window)
  auditLinkKind      String?
  syncedAt           DateTime              @db.Timestamptz(3)

  @@id([installationId, id])
  @@index([installationId, repositoryId, queuedAt(sort: Desc)])
  @@index([installationId, headSha])
  @@index([installationId, status])
  @@index([installationId, definitionId, queuedAt])
  @@index([installationId, queuedAt(sort: Desc)])
}

/// One row per timeline record and attempt (type Job or Stage).
model AzureBuildJob {
  installationId  BigInt
  buildId         Int
  recordId        String
  attempt         Int
  /// Job | Stage
  type            String
  projectId       String
  repositoryId    BigInt?
  identifier      String?
  stageIdentifier String?
  name            String
  /// Matrix and attempt suffixes stripped.
  baseName        String
  /// pending | inProgress | completed
  state           String
  result          AzureJobResult
  poolId          Int?
  isHosted        Boolean?
  /// e.g. "macOS-14", "ubuntu-latest" (job request agentSpecification).
  hostedImage     String?
  os              AzureOs        @default(UNKNOWN)
  /// The agent name (hosted: "Azure Pipelines <n>", self-hosted: the agent's name).
  workerName      String?
  /// Log id of the record (read live for the excerpt, never stored).
  logId           Int?
  queuedAt        DateTime?      @db.Timestamptz(3)
  startedAt       DateTime?      @db.Timestamptz(3)
  finishedAt      DateTime?      @db.Timestamptz(3)
  durationS       Int?
  queueS          Int?
  hitJobCap       Boolean        @default(false)

  @@id([installationId, buildId, recordId, attempt])
  @@index([installationId, startedAt])
  @@index([installationId, repositoryId])
}

model AzurePool {
  installationId BigInt
  id             Int
  name           String
  isHosted       Boolean
  /// automation | deployment
  poolType       String
  size           Int?
  sampledAt      DateTime  @db.Timestamptz(3)
  removedAt      DateTime? @db.Timestamptz(3)

  @@id([installationId, id])
}

/// Self-hosted agents only. Names are stored (the docs advise against personal names).
model AzureAgent {
  installationId  BigInt
  poolId          Int
  id              Int
  name            String
  /// online | offline
  status          String
  enabled         Boolean
  version         String?
  osDescription   String?
  busy            Boolean
  statusChangedAt DateTime? @db.Timestamptz(3)
  sampledAt       DateTime  @db.Timestamptz(3)

  @@id([installationId, poolId, id])
}

/// One observation of a pool (30 days retention).
model AzurePoolSample {
  installationId BigInt
  poolId         Int
  at             DateTime @db.Timestamptz(3)
  running        Int
  queued         Int
  onlineAgents   Int?

  @@id([installationId, poolId, at])
}

/// Org-wide job requests (every project, linked or not): what the free tier counts.
model AzureJobRequest {
  installationId BigInt
  poolId         Int
  requestId      BigInt
  projectId      String?
  isHosted       Boolean
  /// From the project's visibility; null when the project is not known.
  isPrivate      Boolean?
  os             AzureOs   @default(UNKNOWN)
  hostedImage    String?
  queueTime      DateTime  @db.Timestamptz(3)
  assignTime     DateTime? @db.Timestamptz(3)
  finishTime     DateTime? @db.Timestamptz(3)
  /// Equals the timeline record id of the job (verify, docs/AZURE-DEVOPS.md).
  jobId          String?
  /// The owning run id (owner.id).
  buildId        Int?
  result         String?

  @@id([installationId, requestId])
  @@index([installationId, queueTime])
  @@index([installationId, jobId])
}

/// Hosted usage per local day, from org-wide job requests (or builds as a labelled fallback).
model DailyAzureUsage {
  installationId       BigInt
  day                  DateTime @db.Date
  hostedMinutesPrivate Int
  hostedMinutesPublic  Int
  hostedMinutesMacos   Int
  hostedMinutesLinux   Int
  hostedMinutesWindows Int
  peakParallel         Int
  saturatedS           Int
  jobsQueuedOver10m    Int
  /// Queue seconds of hosted jobs while every parallel job was busy.
  saturationQueueS     Int      @default(0)
  /// jobrequests | builds (fallback, partial)
  source               String   @default("jobrequests")

  @@id([installationId, day])
}

model AzureUsageSnapshot {
  installationId BigInt
  /// "YYYY-MM" of the billing month start (from monthResetDay).
  month          String
  /// api | estimate
  source         String
  usedMinutes    Int
  totalMinutes   Int?
  usedParallel   Int
  totalParallel  Int
  isPremium      Boolean?
  capturedAt     DateTime @db.Timestamptz(3)

  @@id([installationId, month, source])
}

model AzureHookSubscription {
  installationId BigInt
  id             String
  eventType      String
  projectId      String?
  /// enabled | onProbation | disabledBySystem | disabledByUser | ...
  status         String
  checkedAt      DateTime @db.Timestamptz(3)

  @@id([installationId, id])
}

/// A local day of an installation whose pipeline stats must be recomputed.
model PipelineRollupDirty {
  installationId BigInt
  day            DateTime @db.Date
  markedAt       DateTime @db.Timestamptz(3)

  @@id([installationId, day])
}

/// Completed builds per definition, local day and branch class (histograms as DailyWorkflowStat).
model DailyPipelineStat {
  installationId          BigInt
  projectId               String
  definitionId            Int
  day                     DateTime @db.Date
  defaultBranch           Boolean
  repositoryId            BigInt?
  builds                  Int
  succeeded               Int
  partial                 Int
  failed                  Int
  canceled                Int
  timedOut                Int
  firstTrySuccess         Int
  flakyRecovered          Int
  durSumS                 BigInt
  durationHist            Int[]
  queueHist               Int[]
  jobSecondsHostedLinux   Int
  jobSecondsHostedWindows Int
  jobSecondsHostedMacos   Int
  jobSecondsSelfHosted    Int
  jobsNearCap             Int

  @@id([installationId, projectId, definitionId, day, defaultBranch])
  @@index([installationId, day])
  @@index([installationId, repositoryId, day])
}

// ---------- findings (shared by the extra tools) ----------

enum FindingSource {
  DEPENDABOT
  CODE_SCANNING
  SECRET_SCANNING
  COMPLIANCE
  HYGIENE
  RUNNER
  UPTIME
  VERCEL
  CREDENTIAL
  AZURE_PIPELINES
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingStatus {
  OPEN
  DISMISSED
  FIXED
}

/// One thing that needs attention. Written by its producer (the Vercel step
/// from M5 on); `ruleKey` is stable, so a finding is updated, not duplicated.
model Finding {
  id             String          @id @default(cuid())
  installationId BigInt
  repositoryId   BigInt?
  source         FindingSource
  /// e.g. "vercel:prod-failing:<projectId>"
  ruleKey        String
  severity       FindingSeverity
  status         FindingStatus
  /// Text only.
  title          String
  /// github.com or vercel.com only.
  externalUrl    String?
  /// Whitelisted fields per source.
  details        Json
  firstSeenAt    DateTime        @db.Timestamptz(3)
  lastSeenAt     DateTime        @db.Timestamptz(3)
  resolvedAt     DateTime?       @db.Timestamptz(3)

  @@unique([installationId, source, repositoryId, ruleKey])
  @@index([installationId, status, severity])
  @@index([installationId, repositoryId, status])
}

/// Per-repository availability of an optional GitHub feature; "not
/// available" is never rendered as 0.
model FeatureAvailability {
  installationId BigInt
  repositoryId   BigInt
  /// code_scanning | secret_scanning | dependabot_alerts | merge_settings ...
  feature        String
  /// available | not_enabled | not_available_on_plan | no_permission
  state          String
  checkedAt      DateTime @db.Timestamptz(3)

  @@id([installationId, repositoryId, feature])
}
