{
  "name": "devops-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted GitHub Actions insights and management through a GitHub App",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "vercel:build": "prisma generate && next build && prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check . --cache",
    "format:write": "prettier --write . --cache",
    "check:privacy": "node scripts/check-personal-data.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "@octokit/app": "^16.1.4",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-paginate-rest": "^15.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@vercel/functions": "^3.11.1",
    "better-auth": "^1.7.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "next-intl": "^4.15.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "oauth2-mock-server": "^9.3.0",
    "postcss": "^8.5.32",
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
